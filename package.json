{
  "name": "george-lopez-english-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/generate.mjs && node scripts/init-db.mjs",
    "dev": "node scripts/init-db.mjs && next dev --webpack --hostname 0.0.0.0",
    "build": "node scripts/generate.mjs && node scripts/init-db.mjs && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "db:init": "node scripts/init-db.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@prisma/client": "7.10.1",
    "prisma": "7.10.1",
    "lucide-react": "^0.468.0",
    "@prisma/adapter-better-sqlite3": "7.10.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4",
    "vitest": "^4",
    "@playwright/test": "^1.58"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module"
}
